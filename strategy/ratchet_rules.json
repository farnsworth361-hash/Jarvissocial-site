    "watchlist_only": [
      {
        "symbol": "GLD",
        "price_at_design": 402.16,
        "restriction": "$1-wide strikes only"
      }
    ]
  },
  "risk_limits": {
    "max_risk_per_position_usd": 150.0,
    "max_concurrent_convexity_positions": 3,
    "max_total_convexity_at_risk_usd": 450.0,
    "max_new_positions_per_week": 2,
    "daily_loss_limit_usd": 150.0,
    "weekly_loss_limit_usd": 225.0,
    "drawdown_circuit_breaker_pct": 0.15,
    "drawdown_halt_days": 30,
    "drawdown_halt_scope": "convexity_only_core_untouched",
    "correlation_cap_same_direction": 2,
    "correlated_groups": [
      [
        "SPY",
        "QQQ",
        "IWM"
      ]
    ],
    "max_annual_refill_pct_of_year_start_equity": 0.2
  },
  "cadence": {
    "daily_scan_et": "09:45",
    "never_trade_the_open": true,
    "open_avoidance_rationale": "First 15 minutes carry the widest spreads of the day (friction constraint C4).",
    "daily_budget_check_et": "15:50",
    "ratchet_click_et": "friday 15:45",
    "monthly_resize": "first_session_of_month"
  },
  "pre_trade_checklist": [
    "setup conditions fully met (no partial credit)",
    "underlying passes all liquidity filters",
    "spread bid/ask <= 10% of mid right now",
    "max loss <= $150",
    "position count after entry <= 3",
    "total sleeve risk after entry <= $450",
    "correlation cap not breached",
    "entries this week <= 2",
    "not in LOCKDOWN; >= 2 day trades available",
    "not in drawdown halt",
    "no earnings before exit date (CB only)",
    "DTE between 30 and 45",
    "GTC target and stop ready to place on fill"
  ],
  "checklist_rule": "Any unchecked box is a NO TRADE. Not a smaller trade -- a no trade.",
  "falsification": {
    "min_closed_trades_before_judging": 60,
    "abandon_if_hit_rate_below": 0.43,
    "abandon_if_avg_friction_pct_of_debit_above": 0.08,
    "abandon_if_underperforms_core_risk_adjusted_over": "1 year",
    "correct_action_on_falsification": "stop trading convexity and hold core; do NOT tune parameters until the backtest looks better"
  },
  "impossible_goal_note": {
