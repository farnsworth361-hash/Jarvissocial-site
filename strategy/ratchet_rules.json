    }
  },
  "disclaimer": "Not financial advice. Specification only. No trades placed. All expectancy figures are illustrative calculations from assumed hit rates, not backtested results.",
  "simulation": {
    "script": "sim/ratchet_sim.py",
    "paths": 20000,
    "sessions": 252,
    "ratchet_p_ruin_all_scenarios": 0.0,
    "ratchet_worst_5th_pct_usd": 1027,
    "doubler_p_ruin_held_to_expiry": 1.0,
    "doubler_p_ruin_with_stop_losses": 1.0,
    "doubler_median_sessions_to_ruin_with_stops": 13,
    "doubler_arithmetic_edge_with_stops": 0.005,
    "doubler_geometric_edge_with_stops": -0.213,
    "key_finding": "A full-size daily bet with a FLAT arithmetic edge still ruins 100% of the time, because volatility drag makes its geometric return -21%/trade. Sizing, not skill, is what defeats this.",
    "caveat": "Assumptions, not backtests. No historical validation of CB or PED filters was performed."
  }
