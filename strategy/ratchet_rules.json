{
  "strategy": "RATCHET",
  "version": "1.0",
  "designed": "2026-09-02",
  "account": {
    "label": "Agentic",
    "account_number_masked": "****8464",
    "type": "limited_margin_individual",
    "option_level": 3,
    "equity_at_design": 1500.0,
    "leverage_available": false,
    "pdt_restricted": true,
    "pdt_threshold": 25000.0
  },
  "sleeves": {
    "core": {
      "target_pct": 0.7,
      "instruments": [
        "broad_index_etf"
      ],
      "fractional_ok": true,
      "may_be_sold_to_fund_convexity": false,
      "rebalance": "monthly"
    },
    "convexity": {
      "target_pct": 0.3,
      "charter_size_usd": 450.0,
      "instruments": [
        "debit_vertical_spread"
      ],
      "is_only_sleeve_that_can_zero": true
    }
  },
  "ratchet": {
    "click_schedule": "friday_1545_ET",
    "on_surplus": {
      "condition": "S > S0",
      "action": "sweep_to_core",
      "amount": "S - S0",
      "note": "Profits are removed from the risk sleeve and never re-risked at larger size."
    },
    "on_deficit": {
      "condition": "S < S0",
      "action": "refill_from_core",
      "amount": "min(S0 - S, 0.02 * total_equity, annual_refill_budget_remaining)",
      "max_refill_pct_of_equity_per_week": 0.02,
      "note": "Losses reload slowly and capped. Revenge sizing is structurally unavailable.",
      "max_annual_refill_pct_of_year_start_equity": 0.2,
      "annual_cap_rationale": "The weekly cap limits the RATE of bleed but not the TOTAL. Without an annual budget, 2%/week for 52 weeks could drain Core entirely."
    },
    "charter_resize": {
      "schedule": "monthly_first_session",
      "formula": "S0 = 0.30 * equity_high_water_mark",
      "may_decrease": false,
      "note": "Bet size follows banked equity only. Never unrealized PnL, never conviction."
    }
  },
  "day_trade_budget": {
    "max_per_rolling_5_business_days": 3,
    "reserved_for": "exits_only",
    "may_be_used_for_entries": false,
    "permitted_exit_reasons": [
      "same_session_stop_breach",
      "gap_or_news_thesis_invalidation",
      "assignment_or_pin_risk_cleanup"
    ],
    "minimum_available_floor": 1,
    "lockdown_trigger": "available_day_trades <= 1",
    "lockdown_effect": "no_new_convexity_entries; core_unaffected"
  },
  "setups": {
    "compression_break": {
      "id": "CB",
      "role": "primary",
      "thesis": "Volatility mean-reverts and clusters; buy cheap optionality ahead of a statistically due expansion. Direction is read off the break, never forecast.",
      "entry_conditions": {
        "rv10_percentile_1y_max": 25,
        "bb20_width_percentile_1y_max": 20,
        "atm_iv_rank_max": 30,
        "max_pct_distance_from_bb20_midline": 0.02,
        "trigger": "first_daily_CLOSE_outside_20day_band",
        "intraday_triggers_allowed": false
      }
    },
    "post_earnings_drift": {
      "id": "PED",
      "role": "diversifier",
      "thesis": "A held earnings gap drifts for weeks as institutions reposition. Enter AFTER the IV crush, never before.",
      "entry_conditions": {
        "sessions_since_earnings_min": 1,
        "sessions_since_earnings_max": 3,
        "min_gap_pct": 0.04,
        "min_relative_volume": 2.0,
        "min_gap_retention_pct": 0.6,
        "consecutive_closes_holding_gap": 2,
        "post_crush_iv_rank_max": 40
      }
    }
  },
  "structure": {
    "type": "debit_vertical_spread",
    "dte_min": 30,
    "dte_max": 45,
    "long_leg_delta_target": 0.3,
    "short_leg": "one_strike_width_further_otm",
    "rationale": "Short leg cuts debit 35-45%, converting a 1-position sleeve into a 3-position sleeve and capping theta bleed."
  },
  "exits": {
    "profit_target_pct_of_debit": 1.0,
    "stop_loss_pct_of_debit": 0.5,
    "time_exit_dte": 10,
    "payoff_ratio": "2:1",
    "break_even_hit_rate": 0.4,
    "break_even_formula": "p*1.00 - (1-p)*0.50 - 0.10_friction = 0  ->  p = 0.40",
    "orders_placed": "GTC_immediately_on_fill",
    "note": "Target is stated in units of DEBIT PAID, not percent of max profit. The two differ and mixing them corrupts all downstream expectancy math."
  },
  "universe_filters": {
    "min_open_interest_at_strike": 1000,
    "max_spread_bid_ask_pct_of_mid": 0.1,
    "min_underlying_adv_shares": 5000000,
    "underlying_price_min": 10.0,
    "underlying_price_max": 120.0,
    "price_band_exception": "index ETFs with $1 strike increments (SPY, QQQ, IWM)",
    "price_band_rationale": "A $5-wide-only chain forces $500 max risk = 33% of account on one position.",
    "excluded": [
      "0DTE",
      "expirations under 21 DTE at entry",
      "stocks under $5",
      "single-name biotech",
      "anything failing liquidity filters"
    ],
    "whitelist": [
